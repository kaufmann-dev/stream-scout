{
  "manifest_version": 3,
  "name": "StreamScout",
  "version": "1.0.0",
  "description": "Finds HLS links (.m3u8) on activated sites and copies the link or an ffmpeg command.",
  "permissions": ["storage", "webRequest", "webNavigation", "scripting", "activeTab"],
  "host_permissions": ["https://stream.mux.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "StreamScout",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
